# Per-wall setup file for: ./setup_wall.sh walls/<this-file>.env
#
# 1. Copy:  cp walls/_template.env walls/my-panel.env
# 2. Edit:  WALL_IP, WALL_GATEWAY_SERIAL, passwords
# 3. Run:   ./setup_wall.sh walls/my-panel.env
#
# Optional shared secrets (all walls): copy walls/_shared.env.example → walls/_shared.env

# --- Required (this wall PC) ---
WALL_NAME=my-panel-name
WALL_IP=10.91.0.89
WALL_SSH_USER=qa
WALL_GATEWAY_SERIAL=XG-2532-3HLKT

# Gateway dropdown (usually this wall's serial first, then others you care about)
GATEWAY_SERIALS=XG-2532-3HLKT

# --- Passwords (set here or in walls/_shared.env) ---
PANEL_SSH_PASS=your_wall_ssh_password
DRIVE_PASSWORD=your_loadbank_pi_ssh_password

# --- SBX USB on this wall (FT232R — never ST-Link ttyACM) ---
DRIVE_SBX_PORT=/dev/ttyUSB0
DRIVE_SBX_SERIAL=
DRIVE_SBX_SERIAL_STRICT=1

# --- Lab defaults (override per wall if needed) ---
DRIVE_EV_URL=http://10.91.1.51:8091
DRIVE_LB2_URL=http://10.91.1.66:8080
DRIVE_OPERATOR=Automation
DRIVE_DASHBOARD_PORT=8765
DRIVE_EV_MAX_AMPS=30
DRIVE_LB2_START_DELAY_SEC=10
DRIVE_TELEMETRY_INTERVAL_SEC=0.5
DRIVE_SLEW_A_PER_S=13

# Gateway SSH for panel capacity / commissioning (required for one-click)
# Preferred: spanssh-config on the lab cell (leave alone once working).
#   ssh -F ~/.ssh/span/<serial>/spanssh-config <serial>
USE_GATEWAY=1
GATEWAY_SSH_AUTH=spanssh
GATEWAY_SSH_HOST=
GATEWAY_SSH_USER=root
GATEWAY_SSH_IDENTITY='~/.ssh/id_ecdsa'

# Remote install path on the wall PC
DRIVE_LAB_DIR=drive_automation
