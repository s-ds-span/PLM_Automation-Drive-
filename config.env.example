# Copy to config.env on the lab cell (never commit config.env with real passwords).
DRIVE_EV_URL=http://10.91.1.51:8091
DRIVE_LB2_URL=http://10.91.1.66:8080
DRIVE_OPERATOR=Automation

# Pi SSH passwords — NOT the wall PC (qa@10.91.0.x) login password.
# If LB1 and LB2 use the same password, set DRIVE_PASSWORD only.
DRIVE_PASSWORD=your_loadbank_pi_ssh_password
# Or set per-Pi:
# DRIVE_EV_PASSWORD=loadbank1_ssh_password
# DRIVE_LB2_PASSWORD=loadbank2_ssh_password

DRIVE_DASHBOARD_PORT=8765
DRIVE_EV_MAX_AMPS=30
DRIVE_LB2_START_DELAY_SEC=10
DRIVE_TELEMETRY_INTERVAL_SEC=0.5
DRIVE_SLEW_A_PER_S=13
# Optional: DRIVE_LOG_DIR=logs  DRIVE_ARTIFACTS_DIR=artifacts

# ---------------------------------------------------------------------------
# Gateway — mandatory for one-click pipeline (commission, ratings, feeder amps).
# Preferred: spanssh-config on the wall (no long-term CA cert):
#   ssh -F ~/.ssh/span/XC-2610-3JFDY/spanssh-config XC-2610-3JFDY
# Legacy: GATEWAY_SSH_HOST + cert (~/.ssh/id_ecdsa + id_ecdsa-cert.pub)
# ---------------------------------------------------------------------------
USE_GATEWAY=1
GATEWAY_SERIAL=XC-2610-3JFDY
GATEWAY_SSH_AUTH=spanssh
# Optional LAN IP only when not using spanssh:
# GATEWAY_SSH_HOST=10.91.1.150
GATEWAY_SSH_USER=root
# auto = if GATEWAY_SERIAL set, require spanssh-config (no LAN publickey fallback);
# spanssh | cert | system | password | agent = force that method only
# GATEWAY_SPANSSH_CONFIG=~/.ssh/span/XC-2610-3JFDY/spanssh-config
GATEWAY_SSH_IDENTITY=~/.ssh/id_ecdsa
# Password is optional fallback only (not preferred):
# GATEWAY_SSH_PASS=
# GATEWAY_SSH_USE_AGENT=1
# Panel ratings write targets (Phase 4)
# DRIVE_SITE_UTILITY_MA=125000
# DRIVE_CONDUCTOR_MA=100000
# DRIVE_FEEDER_BREAKER_A=100
# TRAITS_FEEDER_RESOURCE_ID=1a38529812dd621f
# Optional override only — default is PANEL_ID from gateway:
#   cat /data/span/provisioning/thing.env   →  PANEL_ID=<resource-id>

# ---------------------------------------------------------------------------
# Log capture (lucid-style) — gateway serial → panels_config.yml → wall SSH
# ---------------------------------------------------------------------------
GATEWAY_SERIALS=XC-2543-33KE3,XG-2521-3AGFT,XG-2515-373T6,XG-2532-3HLKT
GATEWAY_CAPTURE_CONFIG_PATH=/home/qa/drive_automation/panels_config.yml
PANEL_CONFIG_PATH=/home/qa/drive_automation/panels_config.yml
PANEL_SSH_PASS=your_wall_ssh_password

# Local USB capture on this wall PC (CAN + FT232R SBX on same host as dashboard)
CAPTURE_SSH_HOST=10.91.0.89
CAPTURE_SSH_USER=qa
# CAPTURE_SSH_PASS=   # optional; falls back to PANEL_SSH_PASS
# One-click pipeline: skip CAN bus capture until PCAN is available (default on).
# DRIVE_MASK_CANBUS=0

# Drive SBX USB adapter on the capture host (REQUIRED for correct device)
# Lucid uses "USB Single Serial" / ttyUSB*; Drive prefers FT232R 0403:6001.
# Prefer SERIAL (+ STRICT=1). PORT alone is unsafe: ttyUSB0 can be the wrong FTDI.
# With STRICT=1, PORT is ignored unless its SER= matches DRIVE_SBX_SERIAL.
# Capture uses stty+cat over SSH (no PTY) so binary SBX frames are not mangled.
# Drive SBX baud is normally 57600 (sbx-ctl). Capture auto-probes
# 57600/115200/38400/19200 unless locked:
# DRIVE_SBX_BAUD=57600
# DRIVE_SBX_BAUD_LOCK=1
# Wall FTDI is often silent (no RS-485 tap); gateway MQTT/journal is mirrored
# into Modbus logs by default (DRIVE_SBX_GATEWAY_FEED=0 to disable).
# DRIVE_SBX_USE_PICOCOM=1  # optional debug only
# DRIVE_SBX_PORT=/dev/ttyUSB0
DRIVE_SBX_SERIAL=BG01DJEP
DRIVE_SBX_SERIAL_STRICT=1
# DRIVE_SBX_PROBE=1
# DRIVE_CAPTURE_DIR=capture_sessions

# Drive commission params (positions -> BC IDs: bc_id = position + 8, e.g. 6/8 -> 14/16)
# DRIVE_SERIAL=DT-xxxx-xxxxx
# DRIVE_TOP_TAB=6            # breaker top position (fallback if UI value absent)
# DRIVE_BOTTOM_TAB=8         # breaker bottom position
# DRIVE_BREAKER_RATING_A=30  # required — commissioned drive current (no 60 A default)
# DER circuit-breaker instance for JAMA-test pipeline (span-pcm cb / relay).
# Required for the dedicated jama-test section (EV + gateway only).
# DRIVE_BREAKER_INSTANCE_ID=17
# Which JAMA cases to run (comma-separated aliases, or "all"). Dashboard can override.
# Aliases: advertise_rates, obeys_breaker, comms_loss, comms_required,
#          no_comms_boot, set_charge_rate_0, power_reset
# DRIVE_CASES=all
# Comms failover waits (cases 6–8, 11). Case 7 alone adds ~2× relay/boot waits.
# DRIVE_COMMS_RELAY_WAIT_SEC=120
# DRIVE_COMMS_BOOT_WAIT_SEC=120
# DRIVE_COMMS_FALLBACK_WAIT_SEC=45
# DRIVE_COMMS_POWER_OFF_SEC=15
# DRIVE_TIMEZONE=Asia/Kolkata   # wall-local stamps in run/pilot JSONL (match SBX Modbus clock)
#   Examples: America/Los_Angeles, Asia/Kolkata, local
# DRIVE_RUN_COMMISSION=0

# One-click pipeline behavior
# DRIVE_PHASE_DELAY_SEC=0    # pause between major stages only (not pilot substeps / LB2 samples)
# DRIVE_EV_DRAW_FRACTION=0.8 # EV draws this fraction of the commissioned drive current

# Local log capture (JAMA-style, wall PC — SBX+CAN+UART, NOT via gateway)
# CAPTURE_SSH_HOST=10.91.0.89
# CAPTURE_SSH_USER=qa
# CAPTURE_SSH_PASS=          # falls back to PANEL_SSH_PASS if unset

# Closed-loop LB2 controller (SBX charge_rate driven)
# DRIVE_LOAD_LOOP_INTERVAL_SEC=1
# DRIVE_LOAD_DEADBAND_A=0.75
# DRIVE_AGGREGATION_TIMEOUT_SEC=180
# DRIVE_SUSTAIN_TIMEOUT_SEC=90
# DRIVE_RECOVERY_TIMEOUT_SEC=60
